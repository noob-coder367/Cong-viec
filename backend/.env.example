PORT=3000
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Server-only secret key (never expose this to frontend)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY
# Existing access PIN configured in Render
ACCESS_PIN=YOUR_SIX_DIGIT_PIN

# Dedicated PIN for Drive administration (6 digits; keep different from chat PIN)
DRIVE_ADMIN_PIN=YOUR_SEPARATE_SIX_DIGIT_DRIVE_PIN
# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://cong-viec.onrender.com/auth/google/callback
FRONTEND_URL=https://cong-viec-ptung1.vercel.app
# Long random secret used to encrypt the Google refresh token in Supabase
GOOGLE_TOKEN_ENCRYPTION_KEY=GENERATE_A_LONG_RANDOM_SECRET
